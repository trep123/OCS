{
	"name": "ocs-monorepo",
	"version": "5.0.0-alpha.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "npm run build:userscript && npm run build:server",
		"build:userscript": "vite build",
		"build:server": "vite build --config vite.server.config.ts",
		"dev:server": "tsx watch src/server/index.ts",
		"start:server": "node dist/server/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^22.7.0",
		"@types/tampermonkey": "^5.5.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vite": "^5.4.0",
		"vitest": "^2.1.0"
	}
}
